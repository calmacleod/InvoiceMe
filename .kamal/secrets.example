# Copy to .kamal/secrets (ignored by Git), then fill in secrets.
RAILS_MASTER_KEY=$(cat config/master.key)
# Keep the existing value when migrating: this encrypts stored Google tokens.
SECRET_KEY_BASE=
# Initial account provisioning only; sign-in uses User/password_digest in the database.
ADMIN_EMAIL=treasurer@eotfoa.ca
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Configure SMTP for the generated password-reset mailer.
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
