<?xml version="1.0" encoding="UTF-8"?>
<office:document-content xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" office:version="1.3">
<office:font-face-decls><style:font-face style:name="Calibri" svg:font-family="Calibri"/></office:font-face-decls>
<office:automatic-styles>
<style:style style:name="HeaderTable" style:family="table"><style:table-properties style:width="7.7188in" table:align="left" fo:margin-left="-0.1457in" fo:margin-bottom="0.16in" fo:keep-with-next="always"/></style:style>
<style:style style:name="LogoColumn" style:family="table-column"><style:table-column-properties style:column-width="1.3465in"/></style:style><style:style style:name="NameColumn" style:family="table-column"><style:table-column-properties style:column-width="6.3723in"/></style:style>
<style:style style:name="HeaderCell" style:family="table-cell"><style:table-cell-properties fo:border="none" fo:padding="0in" style:vertical-align="top"/></style:style>
<style:style style:name="NameCell" style:family="table-cell"><style:table-cell-properties fo:border="none" fo:padding="0in" fo:padding-top="0.24in" style:vertical-align="top"/></style:style>
<style:style style:name="HeaderName" style:family="paragraph"><style:paragraph-properties fo:keep-with-next="always"/><style:text-properties fo:font-size="15pt" fo:font-weight="bold"/></style:style>
<style:style style:name="Logo" style:family="graphic"><style:graphic-properties style:vertical-pos="top" style:vertical-rel="baseline" fo:padding="0in" fo:border="none"/></style:style>
<style:style style:name="Heading" style:family="paragraph"><style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.22in" fo:keep-with-next="always"/><style:text-properties fo:font-size="14pt"/></style:style>
<style:style style:name="Meta" style:family="paragraph"><style:paragraph-properties fo:keep-with-next="always"/></style:style>
<style:style style:name="BeforeTable" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.2in" fo:keep-with-next="always"/><style:text-properties fo:font-weight="bold"/></style:style>
<style:style style:name="Bold" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style><style:style style:name="Emphasis" style:family="text"><style:text-properties fo:font-weight="bold" fo:font-style="italic" style:text-underline-style="solid"/></style:style><style:style style:name="Link" style:family="text"><style:text-properties fo:color="#0563c1" style:text-underline-style="solid"/></style:style>
<style:style style:name="Items" style:family="table"><style:table-properties style:width="7.5729in" table:border-model="collapsing" table:align="left"/></style:style>
<style:style style:name="TableSeparator" style:family="paragraph"><style:paragraph-properties fo:line-height="0.2in" fo:keep-with-next="always"/></style:style>
<% [0.4896,4.375,0.8021,0.8958,1.0104].each_with_index do |width,index| %><style:style style:name="Column<%= index %>" style:family="table-column"><style:table-column-properties style:column-width="<%= width %>in"/></style:style><% end %>
<style:style style:name="ItemRow" style:family="table-row"><style:table-row-properties style:min-row-height="0.2778in" fo:keep-together="always"/></style:style><style:style style:name="SmallRow" style:family="table-row"><style:table-row-properties style:min-row-height="0.2222in" fo:keep-together="always"/></style:style>
<style:style style:name="Cell" style:family="table-cell"><style:table-cell-properties style:vertical-align="middle" fo:padding-top="0in" fo:padding-bottom="0in" fo:padding-left="0.075in" fo:padding-right="0.075in" fo:border="1pt solid #000000"/></style:style><style:style style:name="Header" style:family="table-cell"><style:table-cell-properties style:vertical-align="middle" fo:padding-top="0in" fo:padding-bottom="0in" fo:padding-left="0.075in" fo:padding-right="0.075in" fo:border="1pt solid #000000" fo:background-color="#cccccc"/></style:style>
<style:style style:name="TableText" style:family="paragraph"><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="10pt"/></style:style>
<style:style style:name="Payable" style:family="table"><style:table-properties style:width="5.6389in" table:align="left" fo:margin-bottom="0.2in"/></style:style><style:style style:name="PayableLeft" style:family="table-column"><style:table-column-properties style:column-width="4in"/></style:style><style:style style:name="PayableRight" style:family="table-column"><style:table-column-properties style:column-width="1.6389in"/></style:style><style:style style:name="Yellow" style:family="table-cell"><style:table-cell-properties fo:padding="0in" fo:border="none" fo:background-color="#ffff00"/></style:style>
<style:style style:name="Red" style:family="paragraph"><style:text-properties fo:color="#ff0000" fo:font-weight="bold"/></style:style><style:style style:name="RedRight" style:family="paragraph"><style:paragraph-properties fo:text-align="end"/><style:text-properties fo:color="#ff0000" fo:font-weight="bold"/></style:style>
<style:style style:name="Payment" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.2in"/></style:style>
</office:automatic-styles><office:body><office:text>
<table:table table:name="Letterhead" table:style-name="HeaderTable"><table:table-column table:style-name="LogoColumn"/><table:table-column table:style-name="NameColumn"/><table:table-row><table:table-cell table:style-name="HeaderCell"><text:p><draw:frame draw:style-name="Logo" text:anchor-type="as-char" svg:width="1.0008in" svg:height="0.9736in"><draw:image xlink:href="Pictures/logo.jpg" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/></draw:frame></text:p></table:table-cell><table:table-cell table:style-name="NameCell"><text:p text:style-name="HeaderName"><%= @invoice.issuer['name'].upcase %></text:p></table:table-cell></table:table-row></table:table>
<text:p text:style-name="Heading">FINAL INVOICE FOR <text:span text:style-name="Bold"><%= invoice_heading(@invoice) %></text:span></text:p>
<text:p text:style-name="Meta">Invoice date: <%= @invoice.issued_on.strftime('%B %-d, %Y') %></text:p>
<text:p text:style-name="Meta">Invoice number: <%= @invoice.number %></text:p>
<% if @invoice.due_on %><text:p text:style-name="Meta">Due date: <%= @invoice.due_on.strftime('%B %-d, %Y') %></text:p><% end %>
<% @invoice.recipient_address.to_s.lines.each do |line| %><text:p text:style-name="Meta"><%= line.strip %></text:p><% end %>
<text:p text:style-name="BeforeTable">ATTENTION: <%= @invoice.attention %></text:p>
<table:table table:name="InvoiceItems" table:style-name="Items"><% 5.times do |index| %><table:table-column table:style-name="Column<%= index %>"/><% end %><table:table-header-rows><table:table-row table:style-name="SmallRow"><% %w[Item Description Quantity Rate Charge].each do |label| %><table:table-cell table:style-name="Header"><text:p text:style-name="TableText"><text:span text:style-name="Bold"><%= label %></text:span></text:p></table:table-cell><% end %></table:table-row></table:table-header-rows>
<% @invoice.line_items.each_with_index do |item,index| %><table:table-row table:style-name="ItemRow"><% [index+1,item.description,(item.amount_only? ? "" : number_with_precision(item.quantity,precision:3,strip_insignificant_zeros:true)),(item.amount_only? ? "" : invoice_money(item.rate_cents,rate:true)),invoice_money(item.total_cents)].each do |value| %><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"><%= value %></text:p></table:table-cell><% end %></table:table-row><% end %>
<% [5-@invoice.line_items.size,0].max.times do %><table:table-row table:style-name="ItemRow"><% 5.times do %><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell><% end %></table:table-row><% end %>
<table:table-row table:style-name="SmallRow"><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="TableText"><text:span text:style-name="Bold">Total</text:span></text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"><%= invoice_money(@invoice.total_cents) %></text:p></table:table-cell></table:table-row></table:table>
<%# Google Docs merges adjacent tables and applies the item columns to the payable row. %>
<text:p text:style-name="TableSeparator"/>
<table:table table:name="TotalPayable" table:style-name="Payable"><table:table-column table:style-name="PayableLeft"/><table:table-column table:style-name="PayableRight"/><table:table-row><table:table-cell table:style-name="Yellow"><text:p text:style-name="Red">TOTAL PAYABLE</text:p></table:table-cell><table:table-cell table:style-name="Yellow"><text:p text:style-name="RedRight"><%= invoice_money(@invoice.total_cents) %></text:p></table:table-cell></table:table-row></table:table>
<text:p text:style-name="Payment"><% @invoice.issuer['payment_instructions'].to_s.split(/(check|cheque|e-transfer)/i).each do |part| %><% if part.match?(/\A(check|cheque|e-transfer)\z/i) %><text:span text:style-name="Emphasis"><%= part %></text:span><% else %><%= part %><% end %><% end %></text:p>
<text:p text:style-name="Payment">If paying by <text:span text:style-name="Bold">e-transfer</text:span>, please email <text:a xlink:type="simple" xlink:href="mailto:<%= @invoice.issuer['email'] %>"><text:span text:style-name="Link"><%= @invoice.issuer['email'] %></text:span></text:a></text:p>
<text:p>If paying by <text:span text:style-name="Bold">check</text:span>, please make it payable to:</text:p>
<text:p><text:span text:style-name="Bold"><%= @invoice.issuer['payable_to'] %></text:span></text:p><text:p>And mail to</text:p>
<text:p><text:span text:style-name="Bold"><%= @invoice.issuer['treasurer'] %></text:span></text:p>
<% @invoice.issuer['address'].to_s.lines.each do |line| %><text:p><text:span text:style-name="Bold"><%= line.strip %></text:span></text:p><% end %>
<% if @invoice.public_notes.present? %><text:p/><% @invoice.public_notes.lines.each do |line| %><text:p><%= line.strip %></text:p><% end %><% end %>
<text:p/><text:p text:style-name="Payment">Thank you.</text:p><text:p><%= @invoice.issuer['treasurer'] %></text:p><text:p>Treasurer, EOTFOA</text:p><text:p><text:a xlink:type="simple" xlink:href="mailto:<%= @invoice.issuer['email'] %>"><text:span text:style-name="Link"><%= @invoice.issuer['email'] %></text:span></text:a></text:p>
</office:text></office:body></office:document-content>
