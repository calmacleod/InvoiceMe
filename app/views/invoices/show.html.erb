<div class="page-heading"><div><%= link_to "← Invoice register", root_path, class: "small-link" %><h1><%= @invoice.number %></h1><p><%= @invoice.description %></p></div><div class="actions"><%= badge(@invoice.status) %><% unless @invoice.finalized_at %><%= link_to "Edit draft", edit_invoice_path(@invoice), class: "button" %><% end %><%= link_to "Download PDF ↗", invoice_path(@invoice, format: :pdf), target: "_blank", class: "button" %></div></div>
<% if @invoice.publish_error.present? %><div class="flash alert"><strong>Google sync needs attention.</strong> <%= @invoice.publish_error %> Your invoice and completed export steps are retained. Retry after resolving the problem.</div><% end %>
<div class="editor-layout"><section class="card invoice-paper"><%= render "document" %></section><aside class="editor-aside"><section class="card"><h2><%= @invoice.finalized_at ? "Google records" : "Ready to publish?" %></h2><p class="hint"><%= @invoice.finalized_at ? "Sync safely resumes completed steps and updates the ledger." : "Publishing finalizes the invoice, saves a Google Doc and PDF, and records it in your master spreadsheet." %></p><%= button_to @invoice.finalized_at ? "Sync to Google ↗" : "Finalize & save to Google ↗", publish_invoice_path(@invoice), class: "button primary full", form: { data: { turbo_confirm: "Finalize this invoice and save it to Google Drive and the master spreadsheet? Finalized details cannot be edited." } } %>
<% if @invoice.google_doc_id %><p><%= link_to "Open Google Doc ↗", "https://docs.google.com/document/d/#{@invoice.google_doc_id}/edit", target: "_blank", rel: "noopener" %></p><% end %><% if @invoice.google_pdf_id %><p><%= link_to "Open Drive PDF ↗", "https://drive.google.com/file/d/#{@invoice.google_pdf_id}/view", target: "_blank", rel: "noopener" %></p><% end %><% if @invoice.ledger_row %><p class="hint">Master ledger row <%= @invoice.ledger_row %></p><% end %></section>
<% if @invoice.finalized_at %><section class="card"><h2>Payments</h2><div class="balance"><span>Received</span><strong><%= money(@invoice.received_cents) %></strong><span>Outstanding</span><strong><%= money(@invoice.owed_cents) %></strong></div><% @invoice.payments.each do |p| %><p class="hint"><%= p.received_on %> · <%= p.method %> · <%= money(p.amount_cents) %></p><% end %>
<% if @invoice.owed_cents > 0 %><%= form_with url: payment_invoice_path(@invoice) do |f| %><%= f.label :amount, "Amount received (CAD)" %><%= f.number_field :amount, step: "0.01", min: "0.01", max: @invoice.owed_cents / 100.0, required: true %><%= f.label :received_on, "Deposit date" %><%= f.date_field :received_on, value: Date.current, required: true %><%= f.label :payment_method, "Payment method" %><%= f.select :payment_method, ["Cheque", "E-Deposit", "Direct Deposit", "Cash", "Other"] %><%= f.label :notes, "Payment notes" %><%= f.text_area :notes, rows: 2 %><%= f.submit "Record payment", class: "button full" %><% end %><% end %></section><% end %>
<section class="card"><h2>Private notes</h2><%= form_with url: notes_invoice_path(@invoice), method: :patch do |f| %><%= f.text_area :private_notes, value: @invoice.private_notes, rows: 4, "aria-label": "Private notes" %><%= f.submit "Save notes", class: "button full" %><% end %><p class="hint">For your records. Not included in the document or PDF.</p></section>
<% if @invoice.games.any? %><section class="card"><h2>Linked games</h2><% @invoice.games.each do |g| %><p><strong><%= g.code %> · #<%= g.external_id %></strong><small><%= g.date %> · <%= g.matchup %></small></p><% end %></section><% end %>
<% unless @invoice.finalized_at %><%= button_to "Delete draft", @invoice, method: :delete, class: "text-button danger", form: { data: { turbo_confirm: "Delete this draft?" } } %><% end %></aside></div>
