<%= form_with model: @invoice, html: { id: "invoice-form" } do |f| %>
<% if @invoice.errors.any? %><div class="flash alert"><%= @invoice.errors.full_messages.join(". ") %></div><% end %>
<div class="editor-layout"><div>
<section class="card"><div class="section-heading"><span class="step">01</span><div><h2>Invoice details</h2><p>Who it's for and how you'll find it later.</p></div></div><div class="form-grid"><div><%= f.label :number, "Invoice number" %><%= f.text_field :number, required: true %></div><div><%= f.label :recipient, "Bill to" %><%= f.text_field :recipient, required: true, placeholder: "Ottawa CJFL" %></div><div class="span-two"><%= f.label :description, "Description for master ledger" %><%= f.text_field :description, required: true, placeholder: "2026 season officiating services" %></div><div><%= f.label :contact, "Contact name or email" %><%= f.text_field :contact %></div><div><%= f.label :recipient_address, "Recipient address (optional)" %><%= f.text_area :recipient_address, rows: 2 %></div><div><%= f.label :issued_on, "Invoice date" %><%= f.date_field :issued_on, required: true %></div><div><%= f.label :due_on, "Due date (optional)" %><%= f.date_field :due_on %></div></div></section>
<section class="card"><div class="section-heading"><span class="step">02</span><div><h2>Line items</h2><p>Set your own descriptions, quantities, and rates.</p></div></div><div class="line-items" id="line-items">
<%= f.fields_for :line_items do |item| %><%= render "line_item", item: item %><% end %>
</div><button type="button" class="button dashed" id="add-item">+ Add line item</button><div class="editor-total"><span>Total <small>CAD</small></span><strong id="live-total"><%= money(@invoice.total_cents) %></strong></div></section>
<section class="card"><div class="section-heading"><span class="step">03</span><div><h2>Notes</h2><p>The right details, in the right place.</p></div></div><div class="form-grid"><div><%= f.label :public_notes, "Notes on invoice" %><%= f.text_area :public_notes, rows: 4, placeholder: "Visible to the recipient" %></div><div><%= f.label :private_notes, "Private notes" %><%= f.text_area :private_notes, rows: 4, placeholder: "For your records only. Never included in exports." %></div></div></section>
</div><aside class="editor-aside"><section class="card"><span class="eyebrow">OPTIONAL</span><h2>Link Horizon games</h2><p class="hint">Links keep your records connected. Invoice amounts come from the line items you enter.</p><input type="search" id="game-filter" placeholder="Filter by game code or team…" aria-label="Filter games"><input type="hidden" name="invoice[game_ids][]" value="">
<div class="game-picker"><% @games.each do |g| %><label class="game-option" data-search="<%= [g.code,g.external_id,g.matchup].join(' ').downcase %>"><%= check_box_tag "invoice[game_ids][]", g.id, @invoice.game_ids.include?(g.id) %><span><strong><%= g.code.presence || g.external_id %> · <%= g.date.strftime("%b %-d") %></strong><small><%= g.matchup %></small><small><%= money(g.fees_cents) %> · <%= g.officials.size %> officials</small><% if g.invoices.any? { |i| i.id != @invoice.id } %><small class="amber">Also linked to <%= g.invoices.reject { |i| i.id == @invoice.id }.map(&:number).join(', ') %></small><% end %></span></label><% end %></div>
<% if @games.empty? %><p class="hint">No games imported for this year yet.</p><%= link_to "Import games →", new_game_path, class: "small-link" %><% end %></section><div class="tip"><strong>A draft is just a draft.</strong><p>Save and preview your invoice first. Publish when you're happy with it.</p></div></aside></div>
<div class="form-actions sticky"><%= link_to "Cancel", @invoice.persisted? ? invoice_path(@invoice) : root_path, class: "button" %><%= f.submit "Save & preview →", class: "button primary" %></div>
<template id="line-item-template"><%= f.fields_for :line_items, LineItem.new(quantity: 1), child_index: "NEW_ITEM" do |item| %><%= render "line_item", item: item %><% end %></template>
<% end %>
