<div class="line-row"><%= item.hidden_field :id if item.object.persisted? %><%= item.hidden_field :_destroy, class: "destroy-item" %><div class="line-description"><%= item.label :description, "Description" %><%= item.text_field :description, placeholder: "e.g. Officials", required: true %></div><div><%= item.label :quantity %><%= item.number_field :quantity, step: "0.001", min: "0.001", required: true, class: "item-quantity" %></div><div><%= item.label :rate, "Rate (CAD)" %><%= item.number_field :rate, step: "0.01", min: "0", required: true, class: "item-rate" %></div><button type="button" class="remove-item" aria-label="Remove line item">×</button></div>
