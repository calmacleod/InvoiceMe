<div class="page-heading"><div><span class="eyebrow">YOUR SEASON, IN ORDER</span><h1>Invoices<span class="heading-dot">.</span></h1><p>A clear view of what's drafted, invoiced, and paid.</p></div><%= link_to "+ Create invoice", new_invoice_path, class: "button primary" %></div>
<% finalized = @all_invoices.select(&:finalized_at) %>
<div class="stats"><div class="stat"><span>Total invoiced <span>↗</span></span><strong><%= money(finalized.sum(&:total_cents)) %></strong><small><%= finalized.size %> finalized invoices · <%= current_season.year %></small></div><div class="stat"><span>Received <span>✓</span></span><strong><%= money(finalized.sum(&:received_cents)) %></strong><small class="green">Payments recorded this season</small></div><div class="stat"><span>Outstanding <span>◷</span></span><strong><%= money(finalized.sum(&:owed_cents)) %></strong><small><%= finalized.count { |i| i.owed_cents > 0 } %> invoices awaiting payment</small></div><div class="stat dark"><span>Work in progress <span>✎</span></span><strong><%= @all_invoices.count { |i| !i.finalized_at } %><em>drafts</em></strong><small>Ready when you are</small></div></div>
<section class="card table-card"><div class="table-heading"><div><h2>Invoice register <span class="count"><%= @all_invoices.size %></span></h2><p>Your records for the <%= current_season.year %> season.</p></div><%= form_with url: root_path, method: :get, class: "search" do |f| %><%= f.search_field :q, value: params[:q], placeholder: "Search invoices…", "aria-label": "Search invoices" %><%= f.submit "Search", class: "button" %><% end %></div>
<div class="table-scroll"><table><thead><tr><th>Invoice</th><th>Recipient / description</th><th>Date</th><th>Status</th><th class="numeric">Amount</th><th class="numeric">Balance</th><th></th></tr></thead><tbody>
<% @invoices.each do |invoice| %><tr><td><%= link_to invoice.number, invoice, class: "invoice-link" %></td><td><strong><%= invoice.recipient %></strong><small><%= invoice.description %></small></td><td class="nowrap"><%= invoice.issued_on.strftime("%b %-d, %Y") %></td><td><%= badge(invoice.status) %></td><td class="numeric"><%= money(invoice.total_cents) %></td><td class="numeric"><%= money(invoice.owed_cents) %></td><td><%= link_to "↗", invoice, "aria-label": "Open #{invoice.number}" %></td></tr><% end %>
</tbody></table></div>
<% if @invoices.empty? %><div class="empty"><span class="empty-icon">▤</span><h2><%= params[:q].present? ? "No matching invoices" : "Your next invoice starts here" %></h2><p>Import your games or create an invoice with your own line items.</p><div class="actions"><%= link_to "Import Horizon games", new_game_path, class: "button" %><%= link_to "+ Create invoice", new_invoice_path, class: "button primary" %></div></div><% end %>
<div class="table-bottom"><span>Amounts in CAD</span><span>Drafts stay private until you publish to Google.</span></div></section>
<div class="workflow-card"><div class="workflow-number">01 — 03</div><div><h3>From game day to paid.</h3><p>Import from Horizon, build your invoice, then save to Drive and your master ledger.</p></div><%= link_to "Import games →", new_game_path, class: "small-link" %></div>
