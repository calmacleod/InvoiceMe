<div class="page-heading"><div><span class="eyebrow">THE SEASON'S SOURCE OF TRUTH</span><h1>Games & officials<span class="heading-dot">.</span></h1><p>Your Horizon master list, ready to connect to invoices.</p></div><%= link_to "↑ Import Horizon file", new_game_path, class: "button primary" %></div>
<section class="card table-card"><div class="table-heading"><div><h2>Master game list <span class="count"><%= current_season.games.count %></span></h2><p>Imported fees are reference amounts. Invoice rates remain yours to set.</p></div><%= form_with url: games_path, method: :get, class: "search" do |f| %><%= f.search_field :q, value: params[:q], placeholder: "Game code, number, or team…", "aria-label": "Search games" %><%= f.submit "Search", class: "button" %><% end %></div>
<div class="table-scroll"><table><thead><tr><th>Game / code</th><th>Date</th><th>Matchup / venue</th><th>Officials</th><th class="numeric">Fees paid</th><th>Invoices</th></tr></thead><tbody><% @games.each do |g| %><tr><td><strong>#<%= g.external_id %></strong><small><%= g.code %></small></td><td class="nowrap"><%= g.date.strftime("%b %-d, %Y") %><small><%= g.time %></small></td><td><strong><%= g.matchup %></strong><small><%= g.location %></small></td><td><details><summary><%= g.officials.size %> officials</summary><% g.officials.each do |o| %><small><%= o["name"] %> <%= money(o["paid_cents"]) if o["paid_cents"] %></small><% end %></details><details><summary>Source details</summary><% g.source.each do |source| %><dl class="source-details"><% source.each do |k,v| %><dt><%= k %></dt><dd><%= v %></dd><% end %></dl><% end %></details></td><td class="numeric"><%= money(g.fees_cents) %></td><td><% g.invoices.each do |i| %><%= link_to i.number, i, class: "small-link" %><br><% end %><%= "—" if g.invoices.empty? %></td></tr><% end %></tbody></table></div>
<% if @games.empty? %><div class="empty"><span class="empty-icon">▦</span><h2>Your games belong here</h2><p>Download the master schedule or payroll CSV from Horizon and bring it in.</p><%= link_to "Import games →", new_game_path, class: "button primary" %></div><% end %></section>
