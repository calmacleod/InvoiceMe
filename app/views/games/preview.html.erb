<div class="page-heading"><div><span class="eyebrow">IMPORT · STEP 3 OF 3</span><h1>One last look</h1><p>Review the game totals before saving to your <%= current_season.year %> season.</p></div></div>
<% if @import.errors.any? %><div class="flash alert"><strong>Fix these issues in the file before importing.</strong><ul><% @import.errors.first(30).each do |e| %><li><%= e %></li><% end %></ul></div><%= link_to "Upload corrected file", new_game_path, class: "button" %><% else %><div class="stats"><div class="stat"><span>Games</span><strong><%= @import.games.size %></strong></div><div class="stat"><span>Officials / assignments</span><strong><%= @import.games.values.sum { |g| g[:officials].size } %></strong></div><div class="stat"><span>Total official fees</span><strong><%= money(@import.games.values.sum { |g| g[:fees_cents] }) %></strong></div></div><% end %>
<section class="card table-card"><div class="table-scroll"><table><thead><tr><th>Game</th><th>Code</th><th>Date</th><th>Matchup</th><th>Officials</th><th class="numeric">Fees</th></tr></thead><tbody><% @import.games.values.first(100).each do |g| %><tr><td><%= g[:external_id] %></td><td><%= g[:code] %></td><td><%= g[:date] %></td><td><%= [g[:away_team],g[:home_team]].compact.join(' at ') %></td><td><%= g[:officials].size %></td><td class="numeric"><%= money(g[:fees_cents]) %></td></tr><% end %></tbody></table></div><div class="table-bottom">Showing the first 100 games. All <%= @import.games.size %> games will be imported.</div></section>
<% if @import.errors.empty? %><div class="form-actions"><%= link_to "Cancel", games_path, class: "button" %><%= button_to "Import #{@import.games.size} games →", commit_games_path, class: "button primary" %></div><% end %>
