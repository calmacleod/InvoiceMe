<div class="login-panel card"><span class="eyebrow">EOTFOA TREASURER</span><h1>Welcome back.</h1><p class="muted">Your games, invoices, and records in one place.</p>
<%= form_with url: login_path do |f| %><%= f.label :password, "Workspace password" %><%= f.password_field :password, required: true, autofocus: true, autocomplete: "current-password" %><%= f.submit "Open workspace", class: "button primary full" %><% end %>
<% if Rails.env.development? %><p class="hint">Local development password: <code>invoice-local</code>, unless ADMIN_PASSWORD is set.</p><% end %></div>
