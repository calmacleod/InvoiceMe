<?xml version="1.0" encoding="UTF-8"?>
<office:document-content xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" office:version="1.3">
  <office:automatic-styles>
    <style:style style:name="Organization" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="9pt" fo:keep-with-next="always"/>
      <style:text-properties fo:font-size="15pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Logo" style:family="graphic">
      <style:graphic-properties style:vertical-pos="middle" style:vertical-rel="line" fo:margin-right="9pt"/>
    </style:style>
    <style:style style:name="StatementTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="3pt" fo:keep-with-next="always"/>
      <style:text-properties fo:font-size="23pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="OfficialName" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="5pt" fo:keep-with-next="always"/>
      <style:text-properties fo:font-size="15pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PaymentDetails" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="14pt" fo:keep-with-next="always"/>
      <style:text-properties fo:font-size="10pt" fo:color="#<%= OfficialPaymentStatement::MUTED %>"/>
    </style:style>
    <style:style style:name="Statement" style:family="table">
      <style:table-properties style:width="<%= OfficialPaymentStatement::COLUMN_WIDTHS.sum %>pt" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <% OfficialPaymentStatement::COLUMN_WIDTHS.each_with_index do |width, index| %>
      <style:style style:name="Column<%= index %>" style:family="table-column">
        <style:table-column-properties style:column-width="<%= width %>pt"/>
      </style:style>
    <% end %>
    <% { Entry: 3, Shaded: 3, Total: 5 }.each do |name, padding| %>
      <style:style style:name="<%= name %>" style:family="table-cell">
        <style:table-cell-properties fo:border="0.45pt solid #<%= OfficialPaymentStatement::RULE %>" style:vertical-align="middle"
          fo:padding-top="<%= padding %>pt" fo:padding-bottom="<%= padding %>pt" fo:padding-left="8pt" fo:padding-right="8pt"
          <% if name != :Entry %>fo:background-color="#<%= OfficialPaymentStatement::SHADE %>"<% end %>/>
      </style:style>
    <% end %>
    <style:style style:name="GridHeading" style:family="paragraph">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Amount" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="AmountHeading" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="NetAmount" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
      <style:text-properties fo:font-size="15pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PaymentNoteHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="11pt" fo:margin-bottom="3pt" fo:keep-with-next="always"/>
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PaymentNote" style:family="paragraph">
      <style:paragraph-properties fo:line-height="116%"/>
    </style:style>
    <style:style style:name="FeeNote" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="11pt" fo:keep-with-next="always"/>
      <style:text-properties fo:font-size="9pt" fo:color="#<%= OfficialPaymentStatement::MUTED %>"/>
    </style:style>
    <style:style style:name="Contact" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="<%= @statement.fee_note? ? 5 : 11 %>pt"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Email" style:family="text">
      <style:text-properties fo:color="#<%= OfficialPaymentStatement::INK %>" style:text-underline-style="solid"/>
    </style:style>
  </office:automatic-styles>
  <office:body><office:text>
    <text:p text:style-name="Organization"><draw:frame draw:style-name="Logo" text:anchor-type="as-char" svg:width="42pt" svg:height="41pt"><draw:image xlink:href="Pictures/logo.jpg" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/></draw:frame><text:s/><%= @statement.organization %></text:p>
    <text:p text:style-name="StatementTitle"><%= @statement.heading %></text:p>
    <text:p text:style-name="OfficialName"><%= @statement.official_name %></text:p>
    <text:p text:style-name="PaymentDetails"><%= @statement.payment_details %></text:p>
    <table:table table:name="Earnings" table:style-name="Statement">
      <table:table-column table:style-name="Column0"/>
      <table:table-column table:style-name="Column1"/>
      <% @statement.rows.each do |kind, label, value| %>
        <table:table-row>
          <% if kind == :section %>
            <table:table-cell table:style-name="Shaded" table:number-columns-spanned="2"><text:p text:style-name="GridHeading"><%= label %></text:p></table:table-cell>
            <table:covered-table-cell/>
          <% else %>
            <% cell_style = { item: "Entry", columns: "Shaded", total: "Total" }.fetch(kind) %>
            <% amount_style = { item: "Amount", columns: "AmountHeading", total: "NetAmount" }.fetch(kind) %>
            <table:table-cell table:style-name="<%= cell_style %>"><text:p text:style-name="<%= kind == :item ? "Standard" : "GridHeading" %>"><%= label %></text:p></table:table-cell>
            <table:table-cell table:style-name="<%= cell_style %>"><text:p text:style-name="<%= amount_style %>"><%= value %></text:p></table:table-cell>
          <% end %>
        </table:table-row>
      <% end %>
    </table:table>
    <% if @statement.visible_note %>
      <text:p text:style-name="PaymentNoteHeading">Payment note</text:p>
      <text:p text:style-name="PaymentNote"><% @statement.visible_note.split("\n", -1).each_with_index do |line, index| %><% if index.positive? %><text:line-break/><% end %><%= line %><% end %></text:p>
    <% end %>
    <% if @statement.fee_note? %><text:p text:style-name="FeeNote"><%= OfficialPaymentStatement::FEE_NOTE %></text:p><% end %>
    <text:p text:style-name="Contact"><%= OfficialPaymentStatement::CONTACT %><text:s/><text:a xlink:type="simple" xlink:href="mailto:<%= @statement.email %>"><text:span text:style-name="Email"><%= @statement.email %></text:span></text:a></text:p>
  </office:text></office:body>
</office:document-content>
