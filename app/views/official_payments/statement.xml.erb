<?xml version="1.0" encoding="UTF-8"?>
<office:document-content xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" office:version="1.3">
  <office:automatic-styles>
    <style:style style:name="Banner" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="-10pt" fo:margin-bottom="23pt"/>
      <style:text-properties fo:font-family="Calibri" fo:font-size="14pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Logo" style:family="graphic">
      <style:graphic-properties style:vertical-pos="middle" style:vertical-rel="line" fo:margin-right="9pt"/>
    </style:style>
    <style:style style:name="StatementHeading" style:family="paragraph">
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="StatementCheque" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="16pt"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Statement" style:family="table">
      <style:table-properties style:width="363pt" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Labels" style:family="table-column">
      <style:table-column-properties style:column-width="191pt"/>
    </style:style>
    <style:style style:name="Amounts" style:family="table-column">
      <style:table-column-properties style:column-width="172pt"/>
    </style:style>
    <style:style style:name="Row" style:family="table-row">
      <style:table-row-properties style:min-row-height="24pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0pt" fo:padding-left="5pt" fo:padding-right="5pt" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Shaded" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0pt" fo:padding-left="5pt" fo:padding-right="5pt" style:vertical-align="middle" fo:background-color="#d7d7d7"/>
    </style:style>
    <style:style style:name="StatementSection" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Value" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
      <style:text-properties fo:font-family="Courier New"/>
    </style:style>
    <style:style style:name="Contact" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="27pt" fo:margin-bottom="29pt"/>
    </style:style>
    <style:style style:name="Email" style:family="text">
      <style:text-properties fo:color="#0563c1" fo:font-weight="bold" style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="Tier" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="36pt"/>
    </style:style>
    <style:style style:name="Bold" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
  </office:automatic-styles>
  <office:body><office:text>
    <text:p text:style-name="Banner"><draw:frame draw:style-name="Logo" text:anchor-type="as-char" svg:width="72pt" svg:height="70pt"><draw:image xlink:href="Pictures/logo.jpg" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/></draw:frame><text:s/><%= @statement.organization %></text:p>
    <text:p text:style-name="StatementHeading"><%= @statement.heading %></text:p>
    <text:p text:style-name="StatementCheque"><%= @statement.cheque %></text:p>
    <table:table table:name="Earnings" table:style-name="Statement">
      <table:table-column table:style-name="Labels"/>
      <table:table-column table:style-name="Amounts"/>
      <% @statement.rows.each do |label, cents| %>
        <table:table-row table:style-name="Row">
          <% if cents.nil? %>
            <table:table-cell table:style-name="Shaded" table:number-columns-spanned="2"><text:p text:style-name="StatementSection"><%= label %></text:p></table:table-cell><table:covered-table-cell/>
          <% else %>
            <table:table-cell table:style-name="Shaded"><text:p text:style-name="StatementHeading"><%= label %></text:p></table:table-cell>
            <table:table-cell table:style-name="Cell"><text:p text:style-name="Value"><%= @statement.amount(cents) %></text:p></table:table-cell>
          <% end %>
        </table:table-row>
      <% end %>
    </table:table>
    <text:p text:style-name="Contact"><%= OfficialPaymentStatement::CONTACT %><text:line-break/><text:a xlink:type="simple" xlink:href="mailto:<%= @statement.email %>"><text:span text:style-name="Email"><%= @statement.email %></text:span></text:a></text:p>
    <text:p><%= OfficialPaymentStatement::FEE_NOTE %></text:p>
    <% OfficialPaymentStatement::FEE_TIERS.each do |tier| %>
      <text:p text:style-name="Tier"><%= tier %></text:p>
    <% end %>
    <text:p text:style-name="Tier">It is <text:span text:style-name="Bold">only</text:span> deducted from game fees</text:p>
  </office:text></office:body>
</office:document-content>
