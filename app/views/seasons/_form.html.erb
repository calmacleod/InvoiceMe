<%= form_with model: @season, class: "settings-form" do |f| %>
<% if @season.errors.any? %><div class="flash alert"><%= @season.errors.full_messages.join(". ") %></div><% end %>
<section class="card"><div class="section-heading"><span class="step">01</span><div><h2>Year & Google Drive</h2><p>Paste file or folder URLs, or their Google IDs.</p></div></div>
<div class="form-grid"><div><%= f.label :year %><%= f.number_field :year, required: true %></div><div><%= f.label :sheet_name, "Master spreadsheet tab name" %><%= f.text_field :sheet_name, required: true %></div><div><%= f.label :drive_folder_id, "Invoice folder" %><%= f.text_field :drive_folder_id, placeholder: "https://drive.google.com/drive/folders/…" %></div><div><%= f.label :pdf_folder_id, "PDF folder (optional)" %><%= f.text_field :pdf_folder_id, placeholder: "Uses the invoice folder if empty" %></div><div><%= f.label :spreadsheet_id, "Master spreadsheet" %><%= f.text_field :spreadsheet_id, placeholder: "https://docs.google.com/spreadsheets/d/…" %></div><div><%= f.label :ledger_start_row, "First ledger data row" %><%= f.number_field :ledger_start_row, min: 2, required: true %></div></div>
<p class="hint">The ledger uses columns A–I: invoice number, date, description, contact, invoiced, received, owed, payment method, deposited date. Existing rows remain in place.</p></section>
<section class="card"><div class="section-heading"><span class="step">02</span><div><h2>Organization & payment details</h2><p>These details appear on new invoices. All amounts are in Canadian dollars.</p></div></div>
<div class="form-grid"><% {name: "Organization name", payable_to: "Cheques payable to", treasurer: "Treasurer name", email: "E-transfer / contact email"}.each do |field,label| %><div><%= label_tag "issuer_#{field}", label %><%= text_field_tag "season[issuer][#{field}]", @season.issuer[field.to_s], id: "issuer_#{field}", required: true %></div><% end %><div><%= label_tag :issuer_address, "Mailing address" %><%= text_area_tag "season[issuer][address]", @season.issuer["address"], id: "issuer_address", rows: 4, required: true %></div><div><%= label_tag :issuer_payment_instructions, "Payment instructions" %><%= text_area_tag "season[issuer][payment_instructions]", @season.issuer["payment_instructions"], id: "issuer_payment_instructions", rows: 4 %></div></div></section>
<div class="form-actions"><%= link_to "Back to invoices", root_path, class: "button" %><%= f.submit "Save year settings", class: "button primary" %></div>
<% end %>
